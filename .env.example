# ---------------------------------------------------------------------------
# CineVault environment variables.  Copy to `.env` for local development.
# `.env` is git-ignored. In production set these in Netlify:
#   Site configuration -> Environment variables.
# ---------------------------------------------------------------------------

# ===== PUBLIC (exposed to the browser - prefix VITE_) ======================
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Set to "true" ONLY for a clearly-labelled sample-data preview (no backend needed).
VITE_DEMO_MODE=false
# Client-side upload size hint in MB (server enforces MAX_UPLOAD_BYTES).
VITE_MAX_UPLOAD_MB=10240

# ===== SERVER ONLY (Netlify Functions - NEVER prefix with VITE_) ===========
# Same project URL as above (optional; falls back to VITE_SUPABASE_URL).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service-role / secret key. Bypasses RLS. Mark as "Contains secret values" in Netlify.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Stream
CLOUDFLARE_ACCOUNT_ID=
# API token with permission: Account > Stream > Edit
CLOUDFLARE_STREAM_API_TOKEN=
# Customer subdomain code, e.g. the "abc123" in customer-abc123.cloudflarestream.com
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Signing key (POST /accounts/:id/stream/keys). Use the returned "id" and the base64 "pem".
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
# Secret returned when you register the webhook (PUT /accounts/:id/stream/webhook).
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# TMDB "API Read Access Token" (v4 bearer token) - optional; manual entry works without it.
TMDB_API_READ_TOKEN=

# Optional tuning
MAX_UPLOAD_BYTES=10737418240
MAX_VIDEO_DURATION_SECONDS=21600
PLAYBACK_TOKEN_TTL_SECONDS=14400
