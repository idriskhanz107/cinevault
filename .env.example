# ---------------------------------------------------------------------------
# CineVault environment variables.  Copy to `.env` for local development.
# `.env` is git-ignored. In production set these in Netlify:
#   Site configuration -> Environment variables.
# ---------------------------------------------------------------------------

# ===== PUBLIC (exposed to the browser - prefix VITE_) ======================
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Set to "true" ONLY for a clearly-labelled sample-data preview (no backend needed).
VITE_DEMO_MODE=false
# Client-side upload size hint in MB (server enforces MAX_UPLOAD_BYTES).
VITE_MAX_UPLOAD_MB=10240

# ===== SERVER ONLY (Netlify Functions - NEVER prefix with VITE_) ===========
# Same project URL as above (optional; falls back to VITE_SUPABASE_URL).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service-role / secret key. Bypasses RLS. Mark as "Contains secret values" in Netlify.
SUPABASE_SERVICE_ROLE_KEY=

# Mux Video (replaces Cloudflare Stream for new uploads)
# Access token credentials: Mux dashboard > Settings > Access Tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing key for secure playback: Mux dashboard > Settings > Signing Keys
# Use the key ID and the base64-encoded PKCS8 PEM value shown in the dashboard.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
# Webhook signing secret: Mux dashboard > Webhooks > (select your endpoint) > Signing Secret
# Register your webhook pointing to: https://<your-site>.netlify.app/api/mux-webhook
MUX_WEBHOOK_SECRET=

# Cloudflare Stream (legacy - keep populated only if you have existing CF records to preserve)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_CUSTOMER_CODE=
# CLOUDFLARE_STREAM_SIGNING_KEY_ID=
# CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# TMDB "API Read Access Token" (v4 bearer token) - optional; manual entry works without it.
TMDB_API_READ_TOKEN=

# Optional tuning
MAX_UPLOAD_BYTES=10737418240
MAX_VIDEO_DURATION_SECONDS=21600
PLAYBACK_TOKEN_TTL_SECONDS=14400
